NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Used for invitation and Auth-to-roster linking. Server-only; never expose it
# through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Local: http://localhost:3000 | Production: https://your-production-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Needed for the Gemini transcript assistant on coach check-ins.
GEMINI_API_KEY=your_gemini_api_key
# Optional model override.
GEMINI_MODEL=gemini-2.5-flash
